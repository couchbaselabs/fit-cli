{
  "name": "fit-cli",
  "version": "0.1.0",
  "description": "A CLI tool to help make FIT (Functional Integration Testing) easier to use.",
  "type": "module",
  "bin": {
    "fit": "./dist/index.js"
  },
  "scripts": {
    "help": "bun src/fit/main/main.ts help",
    "start": "bun src/fit/main/main.ts",
    "wizard": "bun src/fit/main/main.ts wizard",
    "run": "bun src/fit/run/run.ts",
    "preset": "bun src/fit/preset/preset.ts",
    "config": "bun src/fit/config/config.ts",
    "replay": "bun src/util/non-fit/replay-entry.ts --replay",
    "definition": "bun src/fit/definition/definition.ts",
    "cloud-instances": "bun src/cloud/cloud-instances/cloud-instances.ts",
    "capella-clusters": "bun src/cloud/capella-clusters/capella-clusters.ts",
    "performer": "bun src/fit/performer/performer.ts",
    "secrets": "bun src/cloud/util/aws/secrets-cli.ts",
    "archive": "bun src/fit/archive/archive.ts",
    "caps": "bun src/fit/caps/caps.ts",
    "upgrade": "bun src/fit/upgrade/upgrade.ts",
    "maintenance": "bun src/fit/maintenance/maintenance.ts",
    "generate-fit-tests-cache": "bun src/fit/shared/select-fit-tests/generate-fit-tests-cache.ts",
    "dev": "bun --watch src/fit/main/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "FORCE_COLOR=1 node --import tsx --test 'src/**/tests/*.test.ts'"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-cloudwatch-logs": "^3.1107.0",
    "@aws-sdk/client-ec2": "^3.1107.0",
    "@aws-sdk/client-iam": "^3.1107.0",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/client-secrets-manager": "^3.1107.0",
    "@aws-sdk/client-ssm": "^3.1107.0",
    "@aws-sdk/client-sts": "^3.1107.0",
    "@aws-sdk/credential-providers": "^3.1107.0",
    "@aws-sdk/lib-storage": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@aws-sdk/shared-ini-file-loader": "^3.374.0",
    "@google-cloud/compute": "^7.0.0",
    "@inquirer/prompts": "^7.10.1",
    "archiver": "^8.0.0",
    "json5": "^2.2.3",
    "postgres": "^3.4.9",
    "xunit-viewer": "^10.6.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "patchedDependencies": {
    "detect-file-encoding-and-language@2.4.0": "patches/detect-file-encoding-and-language@2.4.0.patch"
  },
  "overrides": {
    "ip": "^2.0.1",
    "ws": "^8.21.0",
    "socket.io-parser": "^4.2.7",
    "fast-xml-builder": "^1.2.1",
    "body-parser": "^1.20.6",
    "@inquirer/external-editor": "^3.0.3",
    "yargs": "^18.1.0"
  }
}
