{
  preset: {
    order: 30,
    tags: ['pe', 'situational'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {
        privateEndpoint: {},
      },
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'restart',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['{{environments.testSets.SITUATIONAL_SET_RELEASE}}'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  // used to go to 'dev'
                  resultsEnvironment: 'prod',
                },
                privateEndpoint: {},
              },
              versions: ['{{environments.defaults.capellaClusterVersion}}'],
            },
          ],
        },
      ],
    },
    // Next block tests capellaPreviousClusterVersion.
    // Temporary: it also used to be the one block on GCP (PSC rather than PrivateLink), but
    // GCP has proved too unstable to run release sign-off on. Restore `gcp: {` once it is
    // reliable.
    {
      aws: {
        privateEndpoint: {},
      },
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'restart',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['{{environments.testSets.SITUATIONAL_SET_RELEASE}}'],
              },
              situational: {
                database: {
                  mode: 'hosted',
                  // used to go to 'dev'
                  resultsEnvironment: 'prod',
                },
                privateEndpoint: {},
              },
              versions: ['{{environments.defaults.capellaPreviousClusterVersion}}'],
            },
          ],
        },
      ],
    },
  ],
}
