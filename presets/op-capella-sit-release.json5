{
  preset: {
    order: 30,
    tags: ['capella', 'situational'],
  },
  version: 1,
  type: 'fit',
  // Temporary: pin to the situational run id change until it merges to TFP main. Remove once
  // https://review.couchbase.org/c/transactions-fit-performer/+/252815 is merged.
  setup: {
    repos: {
      'transactions-fit-performer': {
        gerritRef: 'refs/changes/15/252815/3',
      },
    },
  },
  instances: [
    {
      aws: {},
      setup: {
        capellaEnvironment: 'prod',
      },
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'restart',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['{{environments.testSets.SITUATIONAL_SET_RELEASE}}'],
              },
              situational: {
                database: {
                  mode: 'files',
                },
              },
              versions: ['{{environments.defaults.capellaClusterVersion}}'],
            },
          ],
        },
      ],
    },
    // Next block tests capellaPreviousClusterVersion.
    // Temporary: it also used to be the one block on GCP, but GCP has proved too unstable
    // to run release sign-off on. Restore `gcp: {}` once it is reliable.
    {
      aws: {},
      setup: {
        capellaEnvironment: 'prod',
      },
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'restart',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['{{environments.testSets.SITUATIONAL_SET_RELEASE}}'],
              },
              situational: {
                database: {
                  mode: 'files',
                },
              },
              versions: ['{{environments.defaults.capellaPreviousClusterVersion}}'],
            },
          ],
        },
      ],
    },
  ],
}
