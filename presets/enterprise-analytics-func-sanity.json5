// Quick sanity for Analytics functional tests against a self-managed Enterprise
// Analytics cluster — runs a single connection test (ClusterConnectionTest) rather
// than the whole columnar-test-driver suite. See enterprise-analytics-func-lite
// for the full run and notes on the cluster, SDK choice and TLS connection.
{
  preset: {
    order: 10,
    tags: ['enterprise-analytics', 'functional'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'restart',
              },
              runs: [
                {
                  type: 'analytics-functional',
                  fitConfig: 'fit-config-0',
                  tests: {
                    classes: ['com.couchbase.fit.columnar.tests.query.ClusterConnectionTest', 'com.couchbase.fit.columnar.tests.query.QueryTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          columnar: true,
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.enterpriseAnalyticsVersion}}',
            },
          ],
          docker: {
            'passive-load-balancer': true,
            'use-dino-certs': true,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        clusterAccess: {
          clusterParams: {
            loadBalancedCluster: {
              ports: [8095, 18095],
            },
          },
          performer: {
            connectionString: 'http://${defaultHostname}:8095',
            tls: null,
          },
        },
      },
    },
  ],
}
