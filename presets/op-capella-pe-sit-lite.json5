{
  preset: {
    order: 20,
    tags: ['pe', 'situational'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {
        privateEndpoint: {},
      },
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'reuse',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['{{environments.testSets.SITUATIONAL_SET_LITE}}'],
              },
              situational: {
                privateEndpoint: {},
              },
              versions: ['{{environments.defaults.capellaClusterVersion}}']
            },
          ],
        },
      ],
    },
  ],
}
