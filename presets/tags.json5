// Metadata for the tags referenced by `preset.tags` (presets) and `group.tags` (preset
// groups, see groups.json5) in the other presets/*.json5 files. Used to group, order,
// and describe entries in `fit preset list`. `order` controls display order
// of the tag's group (lower first, ties broken alphabetically); a tag missing here just
// displays without a description and sorts after every tag that is listed here.
{
  // Only the op family's cross-cluster "-multi-*" groups (op-multi-func-*, op-multi-sit-*,
  // op-multi-*) carry this tag — they span every cluster (onprem/cng/capella/capella-pe)
  // within the operational SDK. A *specific* cluster's own presets/groups (including the
  // on-prem ones) live under their own cluster tag below (`onprem`/`cng`/`capella`/`pe`),
  // never here — keeping "operational" reserved for "spans more than one cluster" avoids
  // the ambiguity that motivated the `op-onprem-*` naming (see groups.json5's header).
  operational: { order: 5, description: 'Cross-cluster preset groups spanning every cluster the operational SDK supports (on-prem, CNG, Capella, Capella + PrivateLink).' },
  // functional/situational describe every preset regardless of cluster, so their own heading
  // would just be "everything" — hidden from `preset list`; each preset's more specific cluster
  // tag (onprem/cng/pe/capella/enterprise-analytics/columnar) carries the heading.
  functional: { order: 10, description: 'Runs FIT functional tests — CRUD, queries, transactions, and other core SDK operations — against a live cluster.', hiddenFromList: true },
  situational: { order: 20, description: 'Runs FIT situational tests, which exercise SDK behaviour under specific operational conditions (e.g. node failures, topology changes). Always targets a real, hosted Capella cluster for the test-results/coordination database, regardless of which cluster is under test.', hiddenFromList: true },
  onprem: { order: 25, description: 'On-prem, self-managed testing using the operational SDK — the default cluster when no cloud/CNG feature is under test.' },
  cng: { order: 30, description: 'Runs against Cloud Native Gateway (CNG) / Protostellar instead of the operational SDK path.' },
  capella: { order: 40, description: 'Runs against a real Capella cluster, rather than an on-prem/self-managed one.' },
  pe: { order: 50, description: 'Tests Capella Private Endpoint (PrivateLink) connectivity.' },
  'enterprise-analytics': { order: 60, description: 'Analytics testing against a self-managed Enterprise Analytics cluster, using the Enterprise Analytics SDK.' },
  // The Operational Insights server is not released yet, so these presets currently build
  // the same self-managed Enterprise Analytics cluster as the `enterprise-analytics` ones —
  // what differs today is only the SDK/performer under test. Named `insights` to match the
  // SDK values in sdks.ts (`insights-java`, `insights-go`, `insights-dotnet`).
  insights: { order: 65, description: 'Functional testing of the Operational Insights SDKs. The Operational Insights server is not released yet, so these currently run against a self-managed Enterprise Analytics cluster.' },
  columnar: { order: 70, description: 'Analytics testing against a Capella Analytics (cloud) cluster, using the Columnar SDK.' },
  // Legacy aliases kept for back-compat, each carrying its own removal date — see
  // groups.json5's `removalDate` field.
  deprecated: { order: 200, description: 'Deprecated aliases kept for back-compat. Each names its replacement and a removal date; migrate off these before then.' },
}
