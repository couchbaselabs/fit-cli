{
  preset: {
    order: 30,
    tags: ['cng', 'situational'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [],
      clusterlessSessions: [
        {
          performer: {
            image: '{{PERFORMER_IMAGE}}',
            onPortInUse: 'restart',
          },
          runs: [
            {
              type: 'situational',
              tests: {
                presets: ['{{environments.testSets.SITUATIONAL_SET_RELEASE}}'],
              },
              situational: {
                database: {
                  mode: 'files',
                },
                cng: {},
              },
              // Both CNG server lines in sequence. A line's release suite takes ~70 min, so the pair
              // fits one job's 6h budget, and only one cluster at a time lands on the shared ROSA cluster.
              versions: ['{{environments.defaults.cngClusterVersion}}', '{{environments.defaults.cngPreviousClusterVersion}}'],
            },
          ],
        },
      ],
    },
  ],
}
