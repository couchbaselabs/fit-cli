{
  preset: {
    order: 30,
    tags: ['onprem', 'functional'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          // Functional on-prem testing, latest release line.
          clusterConfig: 'latest',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['{{environments.testSets.FUNCTIONAL_SET_RELEASE}}'],
                    reincludeDefaultExcludedGroups: ['slow'],
                  },
                },
              ],
            },
          ],
        }
      ],
    },
    {
      // Temporary: this was the one block on GCP (to mix up the CSPs), but GCP has proved
      // too unstable to run release sign-off on. Restore `gcp: {}` once it is reliable.
      aws: {},
      clusters: [
        {
          // Functional on-prem testing, previous release line.
          clusterConfig: 'previous',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['{{environments.testSets.FUNCTIONAL_SET_RELEASE}}'],
                    reincludeDefaultExcludedGroups: ['slow'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
    {
      // Functional on-prem testing, next (pre-GA) release line.
      aws: {},
      clusters: [
        {
          clusterConfig: 'next',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['{{environments.testSets.FUNCTIONAL_SET_RELEASE}}'],
                    reincludeDefaultExcludedGroups: ['slow'],
                  },
                },
              ],
            },
          ],
        },
      ],
    }
  ],
  clusterConfigs: [
    {
      id: 'latest',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.clusterVersion}}',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
    {
      id: 'previous',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.previousClusterVersion}}',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
    {
      id: 'next',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.nextClusterVersion}}',
              services: ['kv', 'n1ql', 'index', 'fts'],
            },
          ],
          docker: {
            'kv-memory': 4096,
            'fts-memory': 4096,
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
}
