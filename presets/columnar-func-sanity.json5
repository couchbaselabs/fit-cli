// Quick sanity for Analytics functional tests against a Capella Analytics (cloud)
// cluster — runs a connection test and a basic query test rather than the full
// columnar-test-driver suite. See columnar-func-lite for the full run.
{
  preset: {
    order: 10,
    tags: ['columnar', 'functional'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      setup: {
        capellaEnvironment: 'prod',
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'restart',
              },
              runs: [
                {
                  type: 'analytics-functional',
                  fitConfig: 'fit-config-0',
                  tests: {
                    classes: ['com.couchbase.fit.columnar.tests.query.ClusterConnectionTest', 'com.couchbase.fit.columnar.tests.query.QueryTest'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          columnar: true,
          nodes: [
            {
              count: 4,
            },
          ],
          deployer: 'cloud',
          cloud: {
            'cloud-provider': 'aws',
          },
        },
        onClusterExists: 'useExisting',
      },
    },
  ],
  fitConfigs: [
    {
      id: 'fit-config-0',
      config: {
        clusterAccess: {
          performer: {
            connectionString: 'couchbases://${defaultHostname}',
            tls: { insecure: true },
          },
        },
      },
    },
  ],
}
