{
  preset: {
    order: 30,
    tags: ['capella', 'functional'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {},
      clusters: [
        {
          // Functional Capella testing, latest server version.
          clusterConfig: 'latest',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'restart',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['{{environments.testSets.FUNCTIONAL_SET_RELEASE}}'],
                    reincludeDefaultExcludedGroups: ['slow'],
                  },
                },
              ],
            },
          ],
        },
        {
          // Functional Capella testing, previous server version.
          clusterConfig: 'previous',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'restart',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    presets: ['{{environments.testSets.FUNCTIONAL_SET_RELEASE}}'],
                    reincludeDefaultExcludedGroups: ['slow'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'latest',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.capellaClusterVersion}}',
            },
          ],
          cloud: {
            'cloud-provider': 'aws',
          },
        },
        onClusterExists: 'useExisting',
        capella: {
          cloudProvider: 'aws',
          environment: 'prod',
        },
      },
    },
    {
      id: 'previous',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.capellaPreviousClusterVersion}}',
            },
          ],
          cloud: {
            'cloud-provider': 'aws',
          },
        },
        onClusterExists: 'useExisting',
        capella: {
          cloudProvider: 'aws',
          environment: 'prod',
        },
      },
    },
  ],
}
