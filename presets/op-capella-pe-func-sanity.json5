{
  preset: {
    order: 10,
    tags: ['pe', 'functional'],
  },
  version: 1,
  type: 'fit',
  instances: [
    {
      aws: {
        // Places the instance in the fit-cli VPC's default SG so it can reach the
        // Capella PrivateLink endpoint, which lands in the same SG.
        privateEndpoint: {},
      },
      clusters: [
        {
          clusterConfig: 'cluster-0',
          sessions: [
            {
              performer: {
                image: '{{PERFORMER_IMAGE}}',
                onPortInUse: 'restart',
              },
              runs: [
                {
                  type: 'functional',
                  tests: {
                    classes: ['{{environments.testSets.FUNCTIONAL_SET_SANITY}}'],
                  },
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  clusterConfigs: [
    {
      id: 'cluster-0',
      cbdinocluster: {
        config: {
          nodes: [
            {
              count: 3,
              version: '{{environments.defaults.capellaClusterVersion}}',
            },
          ],
          cloud: {
            'cloud-provider': 'aws',
          },
        },
        onClusterExists: 'useExisting',
        capella: {
          cloudProvider: 'aws',
          environment: 'dev',
          privateEndpoint: {},
        },
      },
    },
  ],
}
